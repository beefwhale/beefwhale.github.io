#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./new-post [--images] "Post name"

Creates a hidden Jekyll post using today's date.
  -i, --images  Also create an image folder and configure img_path.
  -h, --help    Show this help.
EOF
}

with_images=false
post_name=""

while (($#)); do
  case "$1" in
    -i|--images)
      with_images=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      post_name="${*:-}"
      break
      ;;
    -*)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$post_name" ]]; then
        post_name+=" $1"
      else
        post_name="$1"
      fi
      ;;
  esac
  shift
done

if [[ -z "$post_name" ]]; then
  usage >&2
  exit 1
fi

slug=$(printf '%s' "$post_name" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')

if [[ -z "$slug" ]]; then
  printf 'The post name must contain at least one letter or number.\n' >&2
  exit 1
fi

today=$(date '+%Y-%m-%d')
timezone=$(date '+%z')
post_path="_posts/${today}-${slug}.md"
image_path="assets/img/posts/${slug}"
template_path="_posts/2000-01-01-template.md"

if [[ -e "$post_path" ]]; then
  printf 'Post already exists: %s\n' "$post_path" >&2
  exit 1
fi

if [[ ! -f "$template_path" ]]; then
  printf 'Post template not found: %s\n' "$template_path" >&2
  exit 1
fi

# YAML single-quoted strings escape an apostrophe by doubling it.
yaml_title=${post_name//\'/\'\'}

cp "$template_path" "$post_path"

# Fill in the values that are specific to this post while preserving the rest
# of the shared template.
temporary_post="${post_path}.tmp"
trap 'rm -f "$temporary_post"' EXIT

while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    title:*)
      printf "title: '%s'\n" "$yaml_title"
      ;;
    date:*)
      printf 'date: %s 00:00:00 %s\n' "$today" "$timezone"
      ;;
    'img_path:'*)
      if [[ "$with_images" == true ]]; then
        printf 'img_path: /%s\n' "$image_path"
      else
        printf '%s\n' "$line"
      fi
      ;;
    *)
      printf '%s\n' "$line"
      ;;
  esac
done < "$post_path" > "$temporary_post"

mv "$temporary_post" "$post_path"
trap - EXIT

printf 'Created %s\n' "$post_path"

if [[ "$with_images" == true ]]; then
  mkdir -p "$image_path"
  printf 'Created %s/\n' "$image_path"
fi
